{
  "name": "boxaide",
  "version": "0.2.16",
  "description": "Free self-host multi-mailbox agentic inbox with web UI + MCP for any agent",
  "type": "module",
  "license": "MIT",
  "bin": {
    "boxaide": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && npm run web:build && npm run web:sync && npm run mcpb:build",
    "mcpb:build": "node scripts/export-mcpb-tools.mjs && mcpb pack apps/mcpb web-next/boxaide.mcpb",
    "build:server": "tsc",
    "start": "node dist/cli.js serve",
    "dev": "tsx src/cli.ts serve",
    "desktop": "node scripts/desktop.mjs",
    "desktop:dist": "node scripts/desktop.mjs --dist",
    "mcp": "tsx src/cli.ts mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "ship": "./scripts/ship.sh",
    "ship:status": "./scripts/ship_status.sh",
    "ship:hooks": "./scripts/install-hooks.sh",
    "web:build": "npm --prefix apps/web ci && npm --prefix apps/web run build",
    "web:sync": "node scripts/web-sync.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "web-next",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "email",
    "imap",
    "smtp",
    "agent",
    "inbox"
  ],
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.0",
    "hono": "^4.13.2",
    "imapflow": "^1.7.0",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
